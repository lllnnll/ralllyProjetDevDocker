# =============================================================================
#  Copier en .env (gitignoré) puis remplacer toutes les valeurs "CHANGE_ME".
#  Le plus simple :  sh scripts/init-env.sh   (génère .env avec des secrets aléatoires)
# =============================================================================

# ── Domaine & accès ──────────────────────────────────────────────────────────
# En local, *.localhost résout vers 127.0.0.1 sans toucher au fichier hosts.
# Sur la VM : par ex. DOMAIN=<ip-netbird>.sslip.io
DOMAIN=localhost
# Port HTTP publié par Traefik (seul port exposé de la stack).
# Si 80 est déjà pris (IIS, WSL...), mettre 8080 ET ajouter ":8080" aux 2 URL ci-dessous.
HTTP_PORT=80
HTTP_BIND=0.0.0.0

RALLLY_URL=http://rallly.${DOMAIN}
AUTHENTIK_URL=http://auth.${DOMAIN}

# ── Versions d'images (épinglées) ────────────────────────────────────────────
# Image Rallly : officielle pour valider l'infra, puis celle du fork publiée par la CI
#   RALLLY_IMAGE=ghcr.io/lllnnll/ralllyprojetdevdocker:main
RALLLY_IMAGE=lukevella/rallly:4
AUTHENTIK_TAG=2026.8.3
TRAEFIK_TAG=v3.7
GARAGE_TAG=v2.3.0
MAILPIT_TAG=v1.31.4

# ── Authentik ────────────────────────────────────────────────────────────────
AUTHENTIK_SECRET_KEY=CHANGE_ME
AUTHENTIK_DB_PASSWORD=CHANGE_ME
# Compte "akadmin" créé au tout premier démarrage (ignoré ensuite)
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME
AUTHENTIK_EMAIL_FROM=authentik@example.com

# ── Rallly ───────────────────────────────────────────────────────────────────
RALLLY_DB_PASSWORD=CHANGE_ME
# 32 caractères minimum
RALLLY_SECRET_PASSWORD=CHANGE_ME
RALLLY_SUPPORT_EMAIL=support@example.com
RALLLY_NOREPLY_EMAIL=noreply@example.com
# Le 1er compte connecté avec cet e-mail peut se déclarer admin sur /control-panel
RALLLY_INITIAL_ADMIN_EMAIL=admin@example.com
RALLLY_EMAIL_LOGIN_ENABLED=true
RALLLY_REGISTRATION_ENABLED=true

# ── SSO Authentik -> Rallly (phase 2) ────────────────────────────────────────
# Le client OIDC est désactivé tant que ID et SECRET sont vides.
RALLLY_OIDC_NAME=Authentik
RALLLY_OIDC_CLIENT_ID=
RALLLY_OIDC_CLIENT_SECRET=

# ── Garage (S3 interne de Rallly) ────────────────────────────────────────────
# 64 caractères hexadécimaux
GARAGE_RPC_SECRET=CHANGE_ME
# Générés par scripts/init-env.sh (hex aléatoire)
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
